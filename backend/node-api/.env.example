NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
# Em produção, informe somente as redes/IPs dos proxies ou load balancers que
# encaminham tráfego ao backend. Sem esta variável, o backend não confia em
# X-Forwarded-For, Forwarded ou X-Real-IP.
# Exemplo de proxy interno: TRUST_PROXY_CIDRS=10.20.0.0/16,2001:db8:20::/64
# DEVELOPMENT pode permanecer vazio; localhost continua sujeito ao rate limit.
TRUST_PROXY_CIDRS=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
BODY_LIMIT_BYTES=1048576
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5178
OPENAPI_ENABLED=true
STORAGE_LOCAL_ROOT=./var/private-storage
STORAGE_MAX_EVIDENCE_BYTES=6291456

DATABASE_URL=postgresql://fab_control_api:replace-me@127.0.0.1:55432/fab_control_node_dev
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Credencial de implantação com acesso ao schema migration; nunca usada pela API em runtime.
MIGRATION_DATABASE_URL=

DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
# DEFAULT_TENANT_ID permanece exclusivo para seed/migração controlada; login não o utiliza.
# Em produção, cada empresa é resolvida por <slug>.TENANT_BASE_DOMAIN.
TENANT_BASE_DOMAIN=vorqix.com.br
# Permitido somente com APP_ENVIRONMENT=DEVELOPMENT e origem loopback.
DEV_TENANT_SLUG=
APP_ENVIRONMENT=DEVELOPMENT
APP_RELEASE_VERSION=1.4.0
API_VERSION=2.0.0
SCHEMA_VERSION=postgres-0017
CONTRACT_VERSION=2.0.0
FRONTEND_VERSION=1.4.0

AUTH_SESSION_HOURS=8
AUTH_FIRST_ACCESS_MINUTES=15
AUTH_MAINTENANCE_SESSION_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_RECOVERY_COOLDOWN_MINUTES=10
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_FIRST_ACCESS_MAX=5
AUTH_RATE_LIMIT_FIRST_ACCESS_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_RECOVERY_MAX=3
AUTH_RATE_LIMIT_RECOVERY_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_MAINTENANCE_MAX=5
AUTH_RATE_LIMIT_MAINTENANCE_WINDOW_SECONDS=900
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
AUTH_RECOVERY_HMAC_SECRET=replace-with-at-least-32-random-characters
AUTH_MAINTENANCE_HMAC_SECRET=replace-with-a-different-32-character-secret

# Somente para a carga controlada de homologação. Não use estas senhas em produção.
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
DEMO_QUALITY_PASSWORD=replace-with-a-strong-demo-password
DEMO_SAFETY_PASSWORD=replace-with-a-strong-demo-password
DEMO_MAINTENANCE_PASSWORD=replace-with-a-strong-demo-password
DEMO_OPERATOR_PASSWORD=replace-with-a-strong-demo-password
DEMO_PCM_PASSWORD=replace-with-a-strong-demo-password
DEMO_PRODUCAO_PASSWORD=replace-with-a-strong-demo-password
