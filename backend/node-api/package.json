{
  "name": "@vorqix/node-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Node.js seguro e multiempresa do Fab Control CMMS",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs/promises').then(({rm}) => Promise.all([rm('dist', { recursive: true, force: true }), rm('coverage', { recursive: true, force: true })]))\"",
    "db:migrate": "tsx src/infrastructure/database/migrate.cli.ts",
    "dev": "tsx watch src/server.ts",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migration:preflight": "tsx src/infrastructure/migration/migration.cli.ts --mode DRY_RUN",
    "migration:run": "tsx src/infrastructure/migration/migration.cli.ts --mode FULL",
    "migration:delta": "tsx src/infrastructure/migration/migration.cli.ts --mode DELTA",
    "maintenance:open": "tsx src/modules/auth/maintenance-window.cli.ts",
    "seed:homologation": "tsx src/infrastructure/demo/seed.cli.ts",
    "start": "node --enable-source-maps dist/server.js",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --all --include=src/**/*.ts --reporter=text --reporter=html npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@node-rs/argon2": "2.0.2",
    "exceljs": "^4.4.0",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "pg": "8.22.0",
    "typebox": "1.3.8",
    "zod": "4.4.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "c8": "12.0.0",
    "eslint": "10.8.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
