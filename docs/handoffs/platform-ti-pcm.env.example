# Copie estes nomes para o .env local de backend/node-api e preencha com os dados do ambiente.
# Não versione senhas, tokens ou URLs reais de banco.

# Conexão usada pela API e também como fallback do migrador.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Opcional: conexão com permissão para criar/alterar objetos do schema.
# Se vazia, o migrador usa DATABASE_URL.
MIGRATION_DATABASE_URL=
